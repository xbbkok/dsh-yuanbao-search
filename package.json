{
  "name": "dsh-yuanbao-search",
  "version": "1.3.0",
  "description": "Yuanbao Search (so.qq.com) as a main panel inside the DeepSeek Harness Web UI, in Chinese and English.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "yuanbao",
    "tencent",
    "search",
    "panel"
  ],
  "license": "MIT",
  "author": "xbbkok",
  "icon": "./icon.svg",
  "homepage": "https://github.com/xbbkok/dsh-yuanbao-search#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xbbkok/dsh-yuanbao-search.git"
  },
  "bugs": {
    "url": "https://github.com/xbbkok/dsh-yuanbao-search/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": "^0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["slots"]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  }
}
